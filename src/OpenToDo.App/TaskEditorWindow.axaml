<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenToDo.App.TaskEditorWindow"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Title="Task">
  <Border Padding="28">
    <StackPanel Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock x:Name="HeadingText" Classes="h2" Text="Task details"/>
        <TextBlock x:Name="SubheadingText" Classes="caption" Text="What needs doing?"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="Title"/>
        <TextBox x:Name="TitleBox" PlaceholderText="e.g. Book dentist appointment" MaxLength="120" KeyDown="TitleBox_OnKeyDown"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="Notes (optional)"/>
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 Height="110" MaxLength="2000" PlaceholderText="Anything worth remembering…"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="Due date (optional)"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <CalendarDatePicker x:Name="DuePicker"/>
          <Button Grid.Column="1" Content="Clear" Click="ClearDate_OnClick" MinHeight="40"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Classes="pill" Content="Today" Click="QuickToday_OnClick"/>
          <Button Classes="pill" Content="Tomorrow" Click="QuickTomorrow_OnClick"/>
          <Button Classes="pill" Content="In a week" Click="QuickWeek_OnClick"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Classes="formError" IsVisible="False" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Click="Cancel_OnClick"/>
        <Button x:Name="SaveButton" Classes="primary" Content="Save task" Click="Save_OnClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
