<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenToDo.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship the logo asset (avalonia-resource: avares://OpenToDo.App/Assets/logo.svg). -->
    <AvaloniaResource Include="Assets/logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenToDo.Core\OpenToDo.Core.csproj" />
    <ProjectReference Include="..\OpenToDo.Data\OpenToDo.Data.csproj" />
    <ProjectReference Include="..\OpenToDo.Plugins\OpenToDo.Plugins.csproj" />
  </ItemGroup>
</Project>
