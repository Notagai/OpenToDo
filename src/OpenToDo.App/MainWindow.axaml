<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:OpenToDo.Core" xmlns:app="using:OpenToDo.App" x:Class="OpenToDo.App.MainWindow" Width="1180" Height="800" MinWidth="900" MinHeight="620" WindowState="FullScreen" Title="OpenToDo">
  <Grid>
  <Grid x:Name="MainContent" ColumnDefinitions="230,*,320" IsVisible="False">
    <Border Grid.Column="0" Background="#14161A" Padding="18"><Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="7"><TextBlock Text="OpenToDo" FontSize="27" FontWeight="Bold" Foreground="#ECEEF1" Margin="4,2,0,22"/><Button Classes="nav" Content="⌂   Home" Click="Home_OnClick"/><Button Classes="nav" Content="☷   Todo" Click="Todo_OnClick"/><Button Classes="nav" Content="✓   Completed" Click="Completed_OnClick"/></StackPanel>
      <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="LOCAL-FIRST" FontSize="11" FontWeight="Bold" Foreground="#9AA1AB" Margin="4,0"/><Button Classes="nav" Content="⚙   Settings" Click="Settings_OnClick"/></StackPanel>
    </Grid></Border>
    <ScrollViewer Grid.Column="1"><Grid Margin="34" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*"><StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="Home" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Your productivity overview." Classes="muted" Foreground="#9AA1AB"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,28,0,0">
        <StackPanel x:Name="HomePanel" Spacing="18">
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
            <Border Classes="card stat"><StackPanel><TextBlock Text="Completed" Classes="muted"/><TextBlock x:Name="CompletedTotal" Text="0" Classes="statNumber"/></StackPanel></Border><Border Grid.Column="1" Classes="card stat"><StackPanel><TextBlock Text="Today" Classes="muted"/><TextBlock x:Name="CompletedDay" Text="0" Classes="statNumber"/></StackPanel></Border><Border Grid.Column="2" Classes="card stat"><StackPanel><TextBlock Text="This week" Classes="muted"/><TextBlock x:Name="CompletedWeek" Text="0" Classes="statNumber"/></StackPanel></Border><Border Grid.Column="3" Classes="card stat"><StackPanel><TextBlock Text="This month" Classes="muted"/><TextBlock x:Name="CompletedMonth" Text="0" Classes="statNumber"/></StackPanel></Border><Border Grid.Column="4" Classes="card stat"><StackPanel><TextBlock Text="This year" Classes="muted"/><TextBlock x:Name="CompletedYear" Text="0" Classes="statNumber"/></StackPanel></Border>
          </Grid>
          <Border Classes="card" Padding="18"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Completion activity" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ChartSubtitle" Text="Last 14 days" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Classes="chart-toggle" Content="Graph" Click="GraphMode_OnClick"/><Button Classes="chart-toggle" Content="Numbers" Click="NumberMode_OnClick"/></StackPanel></Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0"><StackPanel x:Name="GraphPanel"><ItemsControl x:Name="DailyChart"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:AnalyticsBar"><Grid ColumnDefinitions="48,*,Auto" Margin="0,3"><TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center"/><Border Grid.Column="1" Height="12" Width="{Binding Width}" MaxWidth="760" CornerRadius="6" Background="#66708C" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Count}" Margin="10,0,0,0" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
              <StackPanel x:Name="NumberPanel" IsVisible="False"><ItemsControl x:Name="DailyNumbers"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:AnalyticsBar"><Border Padding="10,7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="Bold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
          </Grid></Border>
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Recent tasks" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your next five active tasks." Classes="muted"/></StackPanel><Button Grid.Column="1" Content="View all" Click="Todo_OnClick"/></Grid>
          <ListBox x:Name="TaskList"><ListBox.ItemTemplate><DataTemplate x:DataType="core:TaskItem"><Border Classes="task-row" Padding="8,9" Margin="0"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"><Button Classes="check" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ToggleCompleted_OnClick"><TextBlock Text="○" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" FontSize="17"/></Button><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding DueDate, StringFormat='Due {0:MMM d}'}" Classes="muted" VerticalAlignment="Center"/><TextBlock Text="{Binding Description}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="2" Classes="subtle" Content="Edit" Click="Edit_OnClick"/><Button Grid.Column="3" Classes="danger" Content="Delete" Click="Delete_OnClick"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
        <StackPanel x:Name="TodoPanel" Spacing="12" IsVisible="False"><Button Classes="primary" Content="Make event" Click="NewTask_OnClick" HorizontalAlignment="Left"/><ListBox x:Name="TodoList"><ListBox.ItemTemplate><DataTemplate x:DataType="core:TaskItem"><Border Classes="task-row" Padding="8,9" Margin="0"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8"><Button Classes="check" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ToggleCompleted_OnClick"><TextBlock Text="○" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" FontSize="17"/></Button><Button Grid.Column="1" Classes="drag-handle" Content="⠿" ToolTip.Tip="Drag to reorder" PointerPressed="TaskDrag_OnPointerPressed" PointerMoved="TaskDrag_OnPointerMoved" PointerReleased="TaskDrag_OnPointerReleased"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding DueDate, StringFormat='Due {0:MMM d}'}" Classes="muted" VerticalAlignment="Center"/><TextBlock Text="{Binding Description}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="3" Classes="subtle" Content="Edit" Click="Edit_OnClick"/><Button Grid.Column="4" Classes="danger" Content="Delete" Click="Delete_OnClick"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
        <StackPanel x:Name="CompletedPanel" Spacing="12" IsVisible="False"><TextBlock Text="Completed archive" FontSize="20" FontWeight="SemiBold"/><ListBox x:Name="CompletedList"><ListBox.ItemTemplate><DataTemplate x:DataType="core:TaskItem"><Border Classes="task-row" Padding="8,9" Margin="0"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"><Button Classes="check completed-check" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" FontSize="17"/></Button><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding CompletionHistory.Count, StringFormat='Completions: {0}'}" Classes="muted" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="2" Classes="subtle" Content="Edit" Click="Edit_OnClick"/><Button Grid.Column="3" Classes="restore" Content="Restore" Click="Restore_OnClick"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel x:Name="SettingsPanel" Spacing="16" IsVisible="False"><Border Classes="card" Padding="22"><StackPanel Spacing="14"><StackPanel><TextBlock Text="AI providers" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Connect a provider, fetch its current model catalog, and test the connection." Classes="muted" Foreground="#6B7280" TextWrapping="Wrap"/></StackPanel>
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="11" ColumnSpacing="14"><TextBlock Text="Provider" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ProviderCombo" SelectedIndex="0" SelectionChanged="Provider_OnSelectionChanged"><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Groq"/><ComboBoxItem Content="OpenRouter"/></ComboBox><TextBlock Grid.Row="1" Text="API key" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" PasswordChar="●" PlaceholderText="Stored in the OS credential store"/><TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="ModelComboBox" PlaceholderText="Fetch models, then choose one" MaxDropDownHeight="300"/><TextBlock Grid.Row="3" Text="Temperature" VerticalAlignment="Center"/><NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="TemperatureBox" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0"/><TextBlock Grid.Row="4" Text="Max output tokens" VerticalAlignment="Center"/><NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="MaxOutputTokensBox" Minimum="1" Maximum="131072" Increment="128"/><TextBlock Grid.Row="5" Text="AI test prompt" VerticalAlignment="Top"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="AiPromptBox" AcceptsReturn="True" Height="80" Text="Give me three concise ways to organize today's tasks." TextWrapping="Wrap"/><StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="Fetch models" Click="FetchModels_OnClick"/><Button Content="Save settings" Click="SaveSettings_OnClick"/><Button Content="Test AI" Click="TestAi_OnClick"/></StackPanel></Grid>
          <TextBlock x:Name="AiStatus" Classes="muted" Text="No provider configured yet." TextWrapping="Wrap"/><Border Background="#292C32" Padding="12" CornerRadius="8"><TextBlock x:Name="AiOutput" Text="AI test output will appear here." Foreground="#ECEEF1" TextWrapping="Wrap"/></Border><TextBlock Text="API keys are never written to settings.json. OpenToDo stores them using the native OS credential/keyring system." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel></Border></StackPanel>
      </Grid>
    </Grid>
    </ScrollViewer>
    <Border Grid.Column="2" Background="#17191E" BorderBrush="#2A2D34" BorderThickness="1,0,0,0" Padding="18">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="AI ASSISTANT" FontSize="12" FontWeight="Bold" Foreground="#AAB4D0" LetterSpacing="1.2"/>
          <TextBlock Text="Your tasks, in conversation" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Ask for summaries, new tasks, completions, or a new order." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1D2026" CornerRadius="8" Padding="10"><TextBlock Text="I can help plan, add, and reorder your tasks." FontSize="12" Foreground="#B9BEC7" TextWrapping="Wrap"/></Border>
        <Border Grid.Row="2" Background="#14161A" BorderBrush="#2A2D34" BorderThickness="1" CornerRadius="10" Padding="10"><ScrollViewer x:Name="ChatScroll" Background="Transparent" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatMessages" Spacing="12"><Border HorizontalAlignment="Left" MaxWidth="255" Background="#252932" CornerRadius="12" Padding="12"><TextBlock Text="Hey! I can help organize your tasks. Ask me to summarize, add, complete, or reorder something." TextWrapping="Wrap" Foreground="#D7DAE1"/></Border></StackPanel></ScrollViewer></Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="AiChatInput" AcceptsReturn="True" MinHeight="76" MaxHeight="130" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="Message your assistant…" /><Button Grid.Column="1" Classes="primary" Content="↑" FontSize="22" Width="44" MinHeight="44" VerticalAlignment="Bottom" ToolTip.Tip="Send message" Click="SendAi_OnClick"/></Grid>
        <StackPanel Grid.Row="4" Spacing="8"><Button Content="⚙  AI settings" Click="Settings_OnClick" HorizontalAlignment="Stretch"/><TextBlock x:Name="AiChatStatus" Text="Configure a provider in Settings to start." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
  <Border x:Name="SetupPanel" Background="#181A1F" IsVisible="True" Padding="36">
    <Grid MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <TextBlock Text="OpenToDo" FontSize="15" FontWeight="Bold" Foreground="#AAB4D0" LetterSpacing="1.2"/>
      <StackPanel Grid.Row="1" Spacing="8"><TextBlock Text="Let’s get you set up." FontSize="32" FontWeight="Bold"/><TextBlock Text="What should we call you?" FontSize="19" Foreground="#B9BEC7"/><TextBlock Text="This name stays on this device and helps personalize your workspace." Classes="muted" TextWrapping="Wrap"/></StackPanel>
      <TextBox Grid.Row="2" x:Name="UsernameBox" PlaceholderText="Your name or nickname" MinHeight="46" FontSize="16"/>
      <TextBlock Grid.Row="3" Text="Please enter a name to continue." x:Name="UsernameError" Foreground="#E58A8A" FontSize="12" IsVisible="False"/>
      <Button Grid.Row="4" Classes="primary" Content="Continue  →" Click="SaveProfile_OnClick" HorizontalAlignment="Stretch" MinHeight="44"/>
    </Grid>
  </Border>
</Grid>
</Window>
