<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:OpenToDo.Core" x:Class="OpenToDo.App.MainWindow" Width="1000" Height="650" Title="OpenToDo">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Padding="18" BorderThickness="0,0,1,0">
      <StackPanel Spacing="8">
        <TextBlock Text="OpenToDo" FontSize="26" FontWeight="Bold" Margin="0,0,0,18" />
        <Button Content="⌂  Home" Click="Home_OnClick" HorizontalContentAlignment="Left" />
        <Button Content="☐  Todo" Click="Todo_OnClick" HorizontalContentAlignment="Left" />
        <Button Content="✓  Completed" Click="Completed_OnClick" HorizontalContentAlignment="Left" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28">
      <StackPanel Spacing="6">
        <TextBlock x:Name="PageTitle" Text="Todo" FontSize="32" FontWeight="Bold" />
        <TextBlock x:Name="PageSubtitle" Text="Tasks that still need doing." Opacity="0.7" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
          <TextBox x:Name="TaskTitle" Width="420" PlaceholderText="What needs doing?" />
          <Button Content="Add task" Click="AddTask_OnClick" />
        </StackPanel>
      </StackPanel>

      <ListBox x:Name="TaskList" Grid.Row="1" Margin="0,20,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:TaskItem">
            <Border Padding="12" Margin="0,0,0,8" BorderThickness="1" CornerRadius="6">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Title}" FontSize="16" />
                  <TextBlock Text="{Binding Description}" Opacity="0.65" />
                </StackPanel>
                <Button Grid.Column="1" Content="Complete / Restore" Click="ToggleCompleted_OnClick" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="Delete" Click="Delete_OnClick" Margin="8,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</Window>