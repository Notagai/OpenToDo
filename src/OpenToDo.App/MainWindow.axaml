<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:OpenToDo.Core" x:Class="OpenToDo.App.MainWindow" Width="1050" Height="700" Title="OpenToDo">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Padding="18" BorderThickness="0,0,1,0">
      <StackPanel Spacing="8">
        <TextBlock Text="OpenToDo" FontSize="26" FontWeight="Bold" Margin="0,0,0,18" />
        <Button Content="⌂  Home" Click="Home_OnClick" HorizontalContentAlignment="Left" />
        <Button Content="☐  Todo" Click="Todo_OnClick" HorizontalContentAlignment="Left" />
        <Button Content="✓  Completed" Click="Completed_OnClick" HorizontalContentAlignment="Left" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28">
      <StackPanel Spacing="6">
        <TextBlock x:Name="PageTitle" Text="Todo" FontSize="32" FontWeight="Bold" />
        <TextBlock x:Name="PageSubtitle" Text="Tasks that still need doing." Opacity="0.7" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
          <TextBox x:Name="TaskTitle" Width="420" PlaceholderText="What needs doing?" />
          <Button Content="Add task" Click="AddTask_OnClick" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
        <Grid>
          <StackPanel x:Name="AnalyticsPanel" Spacing="18">
            <Border Padding="20" CornerRadius="10" BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock Text="Tasks completed" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="CompletedTotal" Text="0" FontSize="42" FontWeight="Bold" />
                <TextBlock Text="All completion events recorded by OpenToDo" Opacity="0.65" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Padding="16" CornerRadius="10" BorderThickness="1">
                <StackPanel><TextBlock Text="Today" FontSize="16" /><TextBlock x:Name="CompletedDay" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="16" CornerRadius="10" BorderThickness="1">
                <StackPanel><TextBlock Text="This week" FontSize="16" /><TextBlock x:Name="CompletedWeek" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="16" CornerRadius="10" BorderThickness="1">
                <StackPanel><TextBlock Text="This month" FontSize="16" /><TextBlock x:Name="CompletedMonth" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel>
              </Border>
              <Border Grid.Column="3" Padding="16" CornerRadius="10" BorderThickness="1">
                <StackPanel><TextBlock Text="This year" FontSize="16" /><TextBlock x:Name="CompletedYear" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel>
              </Border>
            </Grid>

            <TextBlock Text="Recent tasks" FontSize="20" FontWeight="SemiBold" />
            <ListBox x:Name="TaskList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TaskItem">
                  <Border Padding="12" Margin="0,0,0,8" BorderThickness="1" CornerRadius="6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="16" />
                        <TextBlock Text="{Binding Description}" Opacity="0.65" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Complete / Restore" Click="ToggleCompleted_OnClick" Margin="8,0,0,0" />
                      <Button Grid.Column="2" Content="Delete" Click="Delete_OnClick" Margin="8,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>