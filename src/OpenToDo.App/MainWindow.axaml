<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:OpenToDo.Core" x:Class="OpenToDo.App.MainWindow" Width="900" Height="600" Title="OpenToDo">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <StackPanel Spacing="6"><TextBlock Text="OpenToDo" FontSize="32" FontWeight="Bold" /><TextBlock Text="A simple, local-first task manager." Opacity="0.7" /></StackPanel>
    <Grid Grid.Row="1" Margin="0,24,0,0" RowDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="TaskTitle" Width="360" PlaceholderText="What needs doing?" /><Button Content="Add task" Click="AddTask_OnClick" /></StackPanel>
      <ListBox x:Name="TaskList" Grid.Row="1" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate x:DataType="core:TaskItem"><TextBlock Text="{Binding Title}" Margin="8" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
  </Grid>
</Window>
