<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:OpenToDo.Core"
        xmlns:app="using:OpenToDo.App"
        x:Class="OpenToDo.App.MainWindow"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        Title="OpenToDo">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Padding="18" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="OpenToDo" FontSize="26" FontWeight="Bold" Margin="0,0,0,18" />
          <Button Classes="nav" Content="⌂  Home" Click="Home_OnClick" />
          <Button Classes="nav" Content="☐  Todo" Click="Todo_OnClick" />
          <Button Classes="nav" Content="✓  Completed" Click="Completed_OnClick" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <Border Height="1" Background="#22000000" />
          <Button Classes="nav" Content="⚙  Settings" Click="Settings_OnClick" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Grid Margin="30" RowDefinitions="Auto,*">
        <StackPanel Spacing="5">
          <TextBlock x:Name="PageTitle" Text="Home" FontSize="32" FontWeight="Bold" />
          <TextBlock x:Name="PageSubtitle" Text="Your productivity overview." Classes="muted" />
          <StackPanel x:Name="AddTaskPanel" Orientation="Horizontal" Spacing="10" Margin="0,18,0,0" IsVisible="False">
            <TextBox x:Name="TaskTitle" Width="420" PlaceholderText="Add a task..." />
            <Button Classes="primary" Content="Add task" Click="AddTask_OnClick" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
          <StackPanel x:Name="HomePanel" Spacing="18">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
              <Border Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="Tasks completed" Classes="muted" /><TextBlock x:Name="CompletedTotal" Text="0" FontSize="34" FontWeight="Bold" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="Today" Classes="muted" /><TextBlock x:Name="CompletedDay" Text="0" FontSize="34" FontWeight="Bold" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="This week" Classes="muted" /><TextBlock x:Name="CompletedWeek" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
              <Border Grid.Column="3" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="This month" Classes="muted" /><TextBlock x:Name="CompletedMonth" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
              <Border Grid.Column="4" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="This year" Classes="muted" /><TextBlock x:Name="CompletedYear" Text="0" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                  <StackPanel><TextBlock Text="Last 14 days" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Completion activity by day." Classes="muted" /></StackPanel>
                  <ItemsControl x:Name="DailyChart">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:AnalyticsBar">
                        <Grid ColumnDefinitions="65,*,Auto" Margin="0,3">
                          <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="14" Width="{Binding Width}" CornerRadius="7" Background="#2563EB" HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Count}" Margin="8,0,0,0" FontWeight="SemiBold" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="18">
                <StackPanel Spacing="12">
                  <StackPanel><TextBlock Text="Last 6 months" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Completion activity by month." Classes="muted" /></StackPanel>
                  <ItemsControl x:Name="MonthlyChart">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:AnalyticsBar">
                        <Grid ColumnDefinitions="65,*,Auto" Margin="0,5">
                          <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="18" Width="{Binding Width}" CornerRadius="9" Background="#14B8A6" HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Count}" Margin="8,0,0,0" FontWeight="SemiBold" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Text="Recent tasks" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Your next five active tasks." Classes="muted" /></StackPanel>
              <Button Grid.Column="1" Content="View all" Click="Todo_OnClick" />
            </Grid>

            <ListBox x:Name="TaskList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TaskItem">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontSize="16" /><TextBlock Text="{Binding Description}" Classes="muted" /></StackPanel>
                      <Button Grid.Column="1" Content="Complete" Click="ToggleCompleted_OnClick" />
                      <Button Grid.Column="2" Content="Delete" Click="Delete_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel x:Name="TodoPanel" Spacing="12" IsVisible="False">
            <TextBlock Text="Active tasks" FontSize="20" FontWeight="SemiBold" />
            <ListBox x:Name="TodoList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TaskItem">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontSize="16" /><TextBlock Text="{Binding Description}" Classes="muted" /></StackPanel>
                      <Button Grid.Column="1" Content="Complete" Click="ToggleCompleted_OnClick" />
                      <Button Grid.Column="2" Content="Delete" Click="Delete_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel x:Name="CompletedPanel" Spacing="12" IsVisible="False">
            <TextBlock Text="Completed archive" FontSize="20" FontWeight="SemiBold" />
            <ListBox x:Name="CompletedList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TaskItem">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontSize="16" /><TextBlock Text="Completed task" Classes="muted" /></StackPanel>
                      <Button Grid.Column="1" Content="Restore" Click="ToggleCompleted_OnClick" />
                      <Button Grid.Column="2" Content="Delete" Click="Delete_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel x:Name="SettingsPanel" Spacing="16" IsVisible="False">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="14">
                <StackPanel>
                  <TextBlock Text="AI providers" FontSize="21" FontWeight="SemiBold" />
                  <TextBlock Text="Connect OpenAI, Groq, or OpenRouter and fetch the models available to your key." Classes="muted" />
                </StackPanel>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="14">
                  <TextBlock Text="Provider" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" x:Name="ProviderCombo" SelectedIndex="0" SelectionChanged="Provider_OnSelectionChanged">
                    <ComboBoxItem Content="OpenAI" />
                    <ComboBoxItem Content="Groq" />
                    <ComboBoxItem Content="OpenRouter" />
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="API key" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" PasswordChar="●" PlaceholderText="Paste your provider API key" />
                  <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ModelComboBox" PlaceholderText="Fetch models, then choose one" MaxDropDownHeight="300" />
                  <TextBlock Grid.Row="3" Text="Temperature" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="TemperatureBox" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0" />
                  <TextBlock Grid.Row="4" Text="Max output tokens" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="MaxOutputTokensBox" Minimum="1" Maximum="131072" Increment="128" />
                  <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Fetch models" Click="FetchModels_OnClick" />
                    <Button Content="Save settings" Click="SaveSettings_OnClick" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="AiStatus" Classes="muted" Text="No provider configured yet." TextWrapping="Wrap" />
                <TextBlock Text="API keys are stored locally in OpenToDo's application data. Treat this settings file as sensitive and never commit it to Git." Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="8">
                <TextBlock Text="Provider defaults" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="OpenAI uses the Responses API with max_output_tokens and store=false. Groq and OpenRouter use their OpenAI-compatible chat-completions endpoints with temperature and max_tokens." TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>