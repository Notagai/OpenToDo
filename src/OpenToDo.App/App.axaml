<Application xmlns="https://github.com/avaloniaui" x:Class="OpenToDo.App.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme/>

    <!-- Clawnify/OpenToDo-inspired neutral UI: warm canvas, white surfaces, indigo accent. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
      <Setter Property="Background" Value="#D9DBDE"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#EEF0F4"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="#5E6AD2"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="#D5D7DA"/>
      <Setter Property="Foreground" Value="#25282D"/>
      <Setter Property="BorderBrush" Value="#BFC2C7"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#E3E5E8"/>
      <Setter Property="Foreground" Value="#25282D"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#CBCDD1"/>
    </Style>

    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#8B93A6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#555D6D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#596275"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#596275"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#596275"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#4B5260"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#E5D9D9"/>
      <Setter Property="Foreground" Value="#7A4545"/>
      <Setter Property="BorderBrush" Value="#CDBABA"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#F1E4E4"/>
      <Setter Property="Foreground" Value="#8F3A3A"/>
      <Setter Property="BorderBrush" Value="#D9BDBD"/>
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#E3E5E8"/>
      <Setter Property="Foreground" Value="#41464E"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
    </Style>

    <Style Selector="Button.subtle:pointerover">
      <Setter Property="Background" Value="#E3E5E8"/>
      <Setter Property="Foreground" Value="#454A53"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9DA3AC"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="11,8"/>
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#24272D"/>
      <Setter Property="Foreground" Value="#D0D3D8"/>
    </Style>

    <Style Selector="Button.chart-toggle">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.check">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Background" Value="#E3E5E8"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#596275"/>
    </Style>

    <Style Selector="Button.check:pointerover">
      <Setter Property="Background" Value="#E3E5E8"/>
      <Setter Property="Foreground" Value="#596275"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
    </Style>

    <Style Selector="Button.completed-check">
      <Setter Property="Foreground" Value="#4E6755"/>
      <Setter Property="Background" Value="#D8E1DA"/>
      <Setter Property="BorderBrush" Value="#B8C8BB"/>
    </Style>
    <Style Selector="Button.completed-check:pointerover">
      <Setter Property="Foreground" Value="#4F7258"/>
      <Setter Property="Background" Value="#E2EBE4"/>
      <Setter Property="BorderBrush" Value="#C3D2C5"/>
    </Style>

    <Style Selector="Button.restore">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#E2EBE4"/>
      <Setter Property="Foreground" Value="#4F7258"/>
      <Setter Property="BorderBrush" Value="#C3D2C5"/>
    </Style>

    <Style Selector="Button.restore:pointerover">
      <Setter Property="Background" Value="#E2EBE4"/>
      <Setter Property="Foreground" Value="#4F7258"/>
      <Setter Property="BorderBrush" Value="#C3D2C5"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#E5E6E8"/>
      <Setter Property="BorderBrush" Value="#C7C9CD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Border.task-row:pointerover">
      <Setter Property="BorderBrush" Value="#D7D9E8"/>
      <Setter Property="Background" Value="#E0E1E4"/>
    </Style>

    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.statNumber">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
  </Application.Styles>
</Application>