<Application xmlns="https://github.com/avaloniaui" x:Class="OpenToDo.App.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="Background" Value="#F5F7FB"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="#6366F1"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.82"/>
    </Style>

    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#818CF8"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4F46E5"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#4338CA"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#3730A3"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="#FEF2F2"/>
      <Setter Property="Foreground" Value="#B91C1C"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#FEE2E2"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#374151"/>
    </Style>

    <Style Selector="Button.subtle:pointerover">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Opacity" Value="0.78"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="13,10"/>
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.chart-toggle">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.check">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#4F46E5"/>
    </Style>

    <Style Selector="Button.check:pointerover">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.completed-check">
      <Setter Property="Foreground" Value="#16A34A"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style Selector="Border.task-row:pointerover">
      <Setter Property="BorderBrush" Value="#C7D2FE"/>
      <Setter Property="Background" Value="#FCFCFF"/>
    </Style>

    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="17"/>
    </Style>

    <Style Selector="TextBlock.statNumber">
      <Setter Property="FontSize" Value="31"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
  </Application.Styles>
</Application>