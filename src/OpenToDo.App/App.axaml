<Application xmlns="https://github.com/avaloniaui" x:Class="OpenToDo.App.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme/>

    <!-- Restrained dark-neutral theme. Interactive states intentionally stay close to base colors. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
      <Setter Property="Background" Value="#181A1F"/>
      <Setter Property="Foreground" Value="#ECEEF1"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#ECEEF1"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9AA1AB"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#272A30"/>
      <Setter Property="Foreground" Value="#ECEEF1"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover">
      <Setter Property="Background" Value="#272A30"/>
      <Setter Property="BorderBrush" Value="#3D4149"/>
    </Style>

    <Style Selector="TextBox.invalid, ComboBox.invalid, NumericUpDown.invalid">
      <Setter Property="BorderBrush" Value="#D85C65"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
      <Setter Property="Background" Value="#272A30"/>
      <Setter Property="BorderBrush" Value="#666F8A"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="Foreground" Value="#E7E9ED"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- No bright hover animation/highlight. Hover is deliberately identical to the base surface. -->
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="Foreground" Value="#E7E9ED"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#292C32"/>
      <Setter Property="Foreground" Value="#E7E9ED"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>

    <Style Selector="Button:focus-visible">
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="BorderBrush" Value="#666F8A"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#555F7A"/>
      <Setter Property="Foreground" Value="#F5F6F8"/>
      <Setter Property="BorderBrush" Value="#626C88"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#555F7A"/>
      <Setter Property="Foreground" Value="#F5F6F8"/>
      <Setter Property="BorderBrush" Value="#626C88"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#50596F"/>
      <Setter Property="Foreground" Value="#F5F6F8"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#3A2B2D"/>
      <Setter Property="Foreground" Value="#D9A7AA"/>
      <Setter Property="BorderBrush" Value="#594044"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#3A2B2D"/>
      <Setter Property="Foreground" Value="#D9A7AA"/>
      <Setter Property="BorderBrush" Value="#594044"/>
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="Foreground" Value="#B9BEC7"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>
    <Style Selector="Button.subtle:pointerover">
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="Foreground" Value="#B9BEC7"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9AA1AB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="11,8"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#202329"/>
      <Setter Property="Foreground" Value="#C9CDD4"/>
    </Style>

    <Style Selector="Button.chart-toggle">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.check">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#9EA6B5"/>
    </Style>
    <Style Selector="Button.check:pointerover">
      <Setter Property="Background" Value="#2B2E35"/>
      <Setter Property="Foreground" Value="#9EA6B5"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>

    <Style Selector="Button.completed-check">
      <Setter Property="Foreground" Value="#8FB39A"/>
      <Setter Property="Background" Value="#28332C"/>
      <Setter Property="BorderBrush" Value="#3A4B40"/>
    </Style>
    <Style Selector="Button.completed-check:pointerover">
      <Setter Property="Foreground" Value="#8FB39A"/>
      <Setter Property="Background" Value="#28332C"/>
      <Setter Property="BorderBrush" Value="#3A4B40"/>
    </Style>

    <Style Selector="Button.restore">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#28332C"/>
      <Setter Property="Foreground" Value="#8FB39A"/>
      <Setter Property="BorderBrush" Value="#3A4B40"/>
    </Style>
    <Style Selector="Button.restore:pointerover">
      <Setter Property="Background" Value="#28332C"/>
      <Setter Property="Foreground" Value="#8FB39A"/>
      <Setter Property="BorderBrush" Value="#3A4B40"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#22252B"/>
      <Setter Property="BorderBrush" Value="#343840"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Border.task-row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#30343C"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.task-row:pointerover">
      <Setter Property="Background" Value="#202329"/>
      <Setter Property="BorderBrush" Value="#3A3E46"/>
    </Style>
    <Style Selector="Border.task-row.dragging">
      <Setter Property="Background" Value="#292E39"/>
      <Setter Property="BorderBrush" Value="#66708C"/>
    </Style>
    <Style Selector="Border.task-row">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.drag-handle">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#737B89"/>
      <Setter Property="Cursor" Value="SizeAll"/>
    </Style>
    <Style Selector="Button.drag-handle:pointerover">
      <Setter Property="Foreground" Value="#C6CCDA"/>
      <Setter Property="Background" Value="#2B2E35"/>
    </Style>

    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.statNumber">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="#ECEEF1"/>
    </Style>

    <!-- Small, consistent transitions make hover/focus feedback feel responsive without slowing actions. -->
    <Style Selector="Button">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="13,10"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.24"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.18"/><BrushTransition Property="BorderBrush" Duration="0:0:0.18"/></Transitions></Setter>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"/></Transitions></Setter>
    </Style>
  </Application.Styles>
</Application>