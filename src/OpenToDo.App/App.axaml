<Application xmlns="https://github.com/avaloniaui" x:Class="OpenToDo.App.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Styles><FluentTheme/><Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/></Style><Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="40"/></Style><Style Selector="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Opacity" Value="0.82"/></Style><Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="Opacity" Value="1"/></Style><Style Selector="Button.chart-toggle"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/></Style><Style Selector="Button.subtle"><Setter Property="MinHeight" Value="34"/></Style><Style Selector="Button.danger"><Setter Property="MinHeight" Value="34"/></Style><Style Selector="Button.primary"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style><Style Selector="Border.card"><Setter Property="Background" Value="#0AFFFFFF"/><Setter Property="BorderBrush" Value="#22000000"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style><Style Selector="Border.stat"><Setter Property="Padding" Value="17"/></Style><Style Selector="TextBlock.statNumber"><Setter Property="FontSize" Value="31"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,6,0,0"/></Style><Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.62"/></Style></Application.Styles></Application>