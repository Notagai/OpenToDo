<Application xmlns="https://github.com/avaloniaui" x:Class="OpenToDo.App.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme/>

    <!-- Clawnify/OpenToDo-inspired neutral UI: warm canvas, white surfaces, indigo accent. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="Background" Value="#F8F9FB"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="#5E6AD2"/>
      <Setter Property="BoxShadow" Value="0 0 0 3 #185E6AD2"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#F8F9FB"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#F3F4F6"/>
    </Style>

    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#5E6AD2"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5E6AD2"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#5E6AD2"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#4F5AC0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#4F5AC0"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#434DAA"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#FEF2F2"/>
      <Setter Property="Foreground" Value="#B91C1C"/>
      <Setter Property="BorderBrush" Value="#FECACA"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#FEE2E2"/>
      <Setter Property="Foreground" Value="#991B1B"/>
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
    </Style>

    <Style Selector="Button.subtle:pointerover">
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9CA3AF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="11,8"/>
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#FFFFFF12"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.chart-toggle">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.check">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#5E6AD2"/>
    </Style>

    <Style Selector="Button.check:pointerover">
      <Setter Property="Background" Value="#F0F1FA"/>
      <Setter Property="Foreground" Value="#4F5AC0"/>
    </Style>

    <Style Selector="Button.completed-check">
      <Setter Property="Foreground" Value="#16A34A"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Border.task-row:pointerover">
      <Setter Property="BorderBrush" Value="#D7D9E8"/>
      <Setter Property="Background" Value="#FAFAFC"/>
    </Style>

    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.statNumber">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
  </Application.Styles>
</Application>